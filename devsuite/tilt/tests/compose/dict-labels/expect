model .override.services | has("db") | not
# trigger manual + auto-start false = TriggerModeManual (2); deps = label + depends_on
result .Manifests[] | select(.Name=="api") | .TriggerMode == 2
result .Manifests[] | select(.Name=="api") | .Labels == {"apis":"apis","backend":"backend"}
result .Manifests[] | select(.Name=="api") | .ResourceDependencies == ["db","migrate"]
result .Manifests[] | select(.Name=="api") | [.DeployTarget.Links[].URL | .Host + .Path] == ["localhost:5080/swagger","localhost:5080/health"]
