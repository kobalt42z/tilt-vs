model .source == "cli"
model .services.api.build_kind == "dotnet" and .services.api.kind_source == "label"
model .services.api.opts.skip_build_layer == true
model .services.api.opts.configuration == "Release"
model .services.api.opts.watch == ["../shared", "../lib"]
model .services.api.opts.debugger_rid == "linux-musl-x64"
model .services.api.opts.live_update == true and .services.api.opts.debugger == true
model .services.api.labels["com.example.other"] == "kept"
model .services.api.image_ref == "dict-labels-api"
model .services.api.build.context | endswith("/tests/compose/_ctx")
model .services.api.build.dockerfile | endswith("/tests/compose/_ctx/Dockerfile")
